<?xml version="1.0"?>
<robot name="uav_ver62">

  <!-- UAV 색상 -->
  <material name="uav_green">
    <color rgba="0.0 0.6 0.0 0.60"/>
  </material>

  <!-- ==================== UAV 본체 ==================== -->

  <link name="base_link">

    <inertial>
      <origin
        xyz="0.050569840203091215 3.202564255348868e-06 0.005434556406299246"
        rpy="0 0 0"/>

      <mass value="15.0"/>

      <inertia
        ixx="0.63"
        iyy="6.46"
        izz="6.46"
        ixy="0.0"
        iyz="0.0"
        ixz="0.0"/>
    </inertial>

    <!-- 비행기 본체 모델 -->
    <visual name="base_link_visual">
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>

      <geometry>
        <mesh
          filename="../meshes/base_link.stl"
          scale="0.0003 0.0003 0.0003"/>
      </geometry>

      <material name="uav_green"/>
    </visual>


    <!-- 본체 충돌 모델 -->
    <collision name="base_link_collision">
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>

      <geometry>
        <mesh
          filename="../meshes/base_link.stl"
          scale="0.0003 0.0003 0.0003"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== 왼쪽 날개 ==================== -->

  <link name="left_wing_1">

    <inertial>
      <origin
        xyz="-0.08189955557332364 -0.6634945672157346 -0.0181460003779636"
        rpy="0 0 0"/>

      <mass value="2.5"/>

      <inertia
        ixx="0.4608"
        iyy="0.0101"
        izz="0.4707"
        ixy="0.0"
        iyz="0.0"
        ixz="0.0"/>
    </inertial>

    <visual name="left_wing_visual">
      <origin xyz="-0.075 0.06 -0.18" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="../meshes/left_wing_1.stl"
          scale="0.0003 0.0003 0.0003"/>
      </geometry>

      <material name="uav_green"/>
    </visual>

    <collision name="left_wing_collision">
      <origin xyz="-0.075 0.06 -0.18" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="../meshes/left_wing_1.stl"
          scale="0.0003 0.0003 0.0003"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== 오른쪽 날개 ==================== -->

  <link name="right_wing_1">

    <inertial>
      <origin
        xyz="-0.08189954828725175 0.663494733381595 -0.01814624263399736"
        rpy="0 0 0"/>

      <mass value="2.5"/>

      <inertia
        ixx="0.4608"
        iyy="0.0101"
        izz="0.4707"
        ixy="0.0"
        iyz="0.0"
        ixz="0.0"/>
    </inertial>

    <visual name="right_wing_visual">
      <origin xyz="-0.075 -0.06 -0.18" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="../meshes/right_wing_1.stl"
          scale="0.0003 0.0003 0.0003"/>
      </geometry>

      <material name="uav_green"/>
    </visual>

    <collision name="right_wing_collision">
      <origin xyz="-0.075 -0.06 -0.18" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="../meshes/right_wing_1.stl"
          scale="0.0003 0.0003 0.0003"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== 날개 관절 ==================== -->

  <joint name="joint_left_wing" type="revolute">

    <origin xyz="-0.075 0.06 0.18" rpy="0 0 3.141592653589793"/>

    <parent link="base_link"/>
    <child link="left_wing_1"/>

    <axis xyz="0.0 0.0 1.0"/>

    <limit
      lower="0.0"
      upper="1.5708"
      effort="50.0"
      velocity="1.0"/>

    <dynamics damping="0.5" friction="0.05"/>

  </joint>


  <joint name="joint_right_wing" type="revolute">

    <origin xyz="-0.075 -0.06 0.18" rpy="0 0 3.141592653589793"/>

    <parent link="base_link"/>
    <child link="right_wing_1"/>

    <axis xyz="0.0 0.0 1.0"/>

    <limit
      lower="-1.5708"
      upper="0.0"
      effort="50.0"
      velocity="1.0"/>

    <dynamics damping="0.5" friction="0.05"/>

  </joint>



  <!-- 실행 중에도 수동 pose를 유지하도록 모든 링크의 중력 비활성화 -->
  <!-- 수동 6D 목표물: 물리엔진의 선속도/각속도에 의한 표류 방지 -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="left_wing_1">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="right_wing_1">
    <gravity>false</gravity>
  </gazebo>

  <!-- base_link와 일치하는 UAV 모델의 world 6D pose 발행 -->
  <gazebo>
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>

</robot>
