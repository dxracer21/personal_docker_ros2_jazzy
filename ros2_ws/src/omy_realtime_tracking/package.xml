<?xml version="1.0"?>
<package format="3">
  <name>omy_realtime_tracking</name>
  <version>0.0.1</version>
  <description>Realtime Jacobian-based OMY tracking launch and control nodes.</description>
  <maintainer email="dxracer21@users.noreply.github.com">dxracer21</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>open_manipulator_bringup</exec_depend>
  <exec_depend>open_manipulator_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>uav_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
