<?xml version="1.0" encoding="UTF-8"?>
<robot name="omy_f3m">
  <group name="omy_arm">
    <chain base_link="link0" tip_link="end_effector_link"/>
  </group>

  <group_state name="home" group="omy_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-1.3950"/>
    <joint name="joint3" value="2.3698"/>
    <joint name="joint4" value="-1.0527"/>
    <joint name="joint5" value="1.5707963267948966"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <disable_collisions link1="world" link2="link0" reason="Adjacent"/>
  <disable_collisions link1="link0" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="end_effector_flange_link" reason="Adjacent"/>
  <disable_collisions link1="end_effector_flange_link" link2="end_effector_link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="link6" reason="Camera mount overlap"/>
  <disable_collisions link1="camera_link" link2="end_effector_flange_link" reason="Camera mount overlap"/>
</robot>
