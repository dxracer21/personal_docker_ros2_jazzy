<?xml version="1.0"?>
<package format="3">
  <name>uav_omy_moveit_config</name>
  <version>0.0.1</version>
  <description>MoveIt configuration for UAV-mounted OMY F3M target tracking.</description>
  <maintainer email="jinsoo@todo.todo">jinsoo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>open_manipulator_description</exec_depend>
  <exec_depend>uav_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
